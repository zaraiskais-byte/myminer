#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

REPO="$(git rev-parse --show-toplevel)"
cd "$REPO"

REMOTE_NAME="origin"
BRANCH="main"

fail() {
    echo
    echo "FAILED: $1"
    echo "NO COMMIT WAS CREATED BY THIS RUN."
    echo "NO PUSH WAS PERFORMED BY THIS RUN."
    exit 1
}

echo "=== CZR AUTO GATE ==="
echo

echo "[1/10] Repository..."
git rev-parse --show-toplevel >/dev/null || fail "Not a Git repository"
CURRENT_BRANCH="$(git branch --show-current)"
[ "$CURRENT_BRANCH" = "$BRANCH" ] || fail "Current branch is not main"

echo
echo "[2/10] Fetching remote..."
git fetch "$REMOTE_NAME" || fail "git fetch"

echo
echo "[3/10] Working tree..."
git diff --check || fail "working tree whitespace check"
git diff --cached --check || fail "staged whitespace check"

echo
echo "[4/10] CMake configure..."
cmake -S . -B build || fail "CMake configure"

echo
echo "[5/10] Build..."
cmake --build build -j2 || fail "Build"

echo
echo "[6/10] Tests..."
ctest --test-dir build --output-on-failure || fail "Tests"

echo
echo "[7/10] Final source checks..."
git diff --check || fail "final working tree check"

echo
echo "[8/10] Staging..."
git add -A || fail "git add"

git reset --     .work-backup-chain-replacement     CMakeLists.txt.before-duplicate-fix     include/caesar/node.hpp.before-accept-tx     include/caesar/node.hpp.before-tx-relay     include/caesar/p2p_frame.hpp.before-tx-relay     include/caesar/p2p_relay.hpp.before-pending-cleanup     include/caesar/p2p_relay.hpp.before-session-isolation     include/caesar/p2p_relay.hpp.before-tx-relay     >/dev/null 2>&1 || true

git diff --cached --check || fail "staged source check"

if git diff --cached --quiet; then
    echo
    echo "NO CHANGES TO COMMIT."
    LOCAL="$(git rev-parse HEAD)"
    REMOTE="$(git rev-parse "$REMOTE_NAME/$BRANCH")"
    echo "LOCAL : $LOCAL"
    echo "REMOTE: $REMOTE"

    [ "$LOCAL" = "$REMOTE" ] || fail "Local and remote commits differ"
    echo
    echo "CZR AUTO GATE PASSED"
    exit 0
fi

echo
echo "[9/10] Creating commit..."
STAMP="$(date '+%Y-%m-%d %H:%M:%S %z')"
git commit -m "CZR: automated verified update $STAMP" || fail "git commit"

NEW_SHA="$(git rev-parse HEAD)"

echo
echo "Committed:"
echo "$NEW_SHA"

echo
echo "[10/10] Pushing..."
git push "$REMOTE_NAME" "$BRANCH" || fail "git push"

echo
echo "Verifying remote..."
git fetch "$REMOTE_NAME" || fail "post-push fetch"

LOCAL_SHA="$(git rev-parse HEAD)"
REMOTE_SHA="$(git rev-parse "$REMOTE_NAME/$BRANCH")"

echo "LOCAL : $LOCAL_SHA"
echo "REMOTE: $REMOTE_SHA"

[ "$LOCAL_SHA" = "$REMOTE_SHA" ] || fail "Remote SHA does not match local SHA"

echo
echo "CZR AUTO GATE PASSED"
echo "BUILD: PASS"
echo "TESTS: PASS"
echo "COMMIT: $LOCAL_SHA"
echo "PUSH: PASS"
echo "REMOTE VERIFICATION: PASS"
