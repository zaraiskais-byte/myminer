async function api(path,opts){

  const o=Object.assign({credentials:'include'},opts||{});

  const ac=new AbortController();

  const timer=setTimeout(()=>ac.abort(), 8000);

  o.signal=ac.signal;

  try{

    const _p=path+((path.indexOf('?')>=0)?'&':'?')+'_t='+Date.now(); const r=await fetch(_p,Object.assign({cache:'no-store'},o||{}));

    const t=await r.text();

    try{return JSON.parse(t)}catch(e){return {_raw:t,_status:r.status}}

  }catch(e){

    return {error:'timeout', _aborted:true};

  }finally{

    clearTimeout(timer);

  }

}



function unlock(){

  var pinEl = document.getElementById('pin');

  var msg = document.getElementById('msg');

  var pin = pinEl ? (pinEl.value || '').trim() : '';



  if(!pin || pin.length < 4){

    if(msg) msg.textContent = 'Please enter a PIN (4+ digits)';

    return;

  }



  if(msg) msg.textContent = 'Checking wallet...';



  api('/api/auth/status')

    .then(function(status){

      if(!status || status.error){

        throw new Error('Unable to read wallet status');

      }



      var endpoint = status.has_pin

        ? '/api/auth/unlock'

        : '/api/auth/setup';



      return api(endpoint,{

        method:'POST',

        headers:{'Content-Type':'application/json'},

        body:JSON.stringify({pin:pin})

      });

    })

    .then(function(result){

      if(!result || result.unlocked !== true){

        throw new Error(

          result && result.error

            ? result.error

            : 'Wallet unlock failed'

        );

      }



      if(msg) msg.textContent = '';



      var lock = document.getElementById('lock');

      var app = document.getElementById('app');



      if(lock) lock.style.display = 'none';

      if(app) app.style.display = 'flex';



      if(typeof startPolling === 'function'){

        startPolling();

      }



      if(typeof refreshAll === 'function'){

        return refreshAll();

      }



      if(typeof refreshWallet === 'function'){

        return refreshWallet();

      }



      return null;

    })

    .catch(function(err){

      if(msg){

        msg.textContent =

          err && err.message

            ? err.message

            : 'Wallet unlock failed';

      }

    });

}



